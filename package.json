  "license": "ISC",
  "dependencies": {
    "@mdit/plugin-katex": "^1.1.5",
    "gray-matter": "^4.0.3",
    "katex": "^0.19.1",
    "markdown-it": "^15.0.3",
    "playwright": "^1.65.0"
  }
}
